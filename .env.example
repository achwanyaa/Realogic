# Copy this file to .env.local and fill it in. .env.local is never committed.

# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used for events and briefings.
SUPABASE_SECRET_KEY=

# Which site plain localhost and preview links show: realogic, console or luxuryboma
DEFAULT_SITE=realogic
